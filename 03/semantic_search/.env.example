# Copy this file to `.env` and fill in your own values.
# NEVER commit the `.env` file: it is listed in .gitignore.
# Every setting has a default (see app/core/config.py); only the key is needed.

# --- LLM (OpenAI) ------------------------------------------------------------
# Without a key the search still works: chunks are indexed as they are and queries
# are searched as typed. Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Ingestion: for each chunk, the LLM writes its context, the questions it answers,
# similar (popular/technical) terms and content types. Runs once per chunk and is
# cached in ENRICHMENT_CACHE_PATH, so re-running the ingestion does not pay again.
ENRICHMENT_ENABLED=true
ENRICHMENT_MODEL=gpt-5-nano
ENRICHMENT_CONCURRENCY=8
ENRICHMENT_CACHE_PATH=data/enrichment_cache.json

# Search: the LLM rewrites the query in the articles' vocabulary and extracts its
# similar terms, categories and content types (cached in memory per query).
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MODEL=gpt-5-nano

# Sent only to reasoning models (gpt-5, o-series); leave empty to send nothing.
LLM_REASONING_EFFORT=minimal
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# Share of the score headroom added when a chunk's category or content type matches
# the query's (0 disables the boost).
METADATA_BOOST=0.15

# --- Results -----------------------------------------------------------------
# Chunks taken on each side of a result to build its `context_text` (the larger
# passage handed to a RAG answer); 0 keeps only the matched chunk.
CONTEXT_NEIGHBORS=1

# --- Relevance ---------------------------------------------------------------
# Cross-encoder score below which a result is flagged as low relevance.
# 0.05 was calibrated on the evaluation set: 96% of the right answers are shown
# and every out-of-collection question tested is blocked (see docs/EVALUATION.md).
RELEVANCE_THRESHOLD=0.05

# --- Runtime -----------------------------------------------------------------
# DEVICE=auto
# TORCH_NUM_THREADS=2
LOG_LEVEL=INFO
