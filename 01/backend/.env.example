# Copy this file to `.env` and adjust the values as needed.
# Every variable is optional; environment variables override this file.

APP_NAME="Library API"
APP_VERSION="0.1.0"
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------------
DATABASE_URL="sqlite:///./library.db"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
# -1 never recycles connections.
DB_POOL_RECYCLE_SECONDS=1800
SQLITE_BUSY_TIMEOUT_SECONDS=5

# --- Pagination ---------------------------------------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- HTTP security ------------------------------------------------------------
# Comma-separated lists.
CORS_ORIGINS="http://localhost:8050,http://127.0.0.1:8050"
# "*" accepts any Host header.
ALLOWED_HOSTS="localhost,127.0.0.1,api"
# Empty disables the key. When set, every /books request must send `X-API-Key`,
# and frontend/.env must have the same value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=""
ENABLE_DOCS=true
# Print API_KEY at the top of /docs. Only for a public demo whose key is not secret.
DOCS_SHOW_API_KEY=false
MAX_REQUEST_BODY_BYTES=65536
# 0 disables the rate limit.
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
