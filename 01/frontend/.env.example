# Copy this file to `.env` and adjust the values as needed.
# Every variable is optional; environment variables override this file.

API_BASE_URL="http://localhost:8000"
# Must be the same value as API_KEY in backend/.env (leave empty if the API has no key).
API_KEY=""
API_TIMEOUT_SECONDS=5
API_MAX_PAGE_SIZE=100
SEARCH_PAGE_SIZE=10
DASH_HOST="127.0.0.1"
DASH_PORT=8050
# Development server: restart on code changes and refresh the browser automatically.
DASH_DEBUG=true
