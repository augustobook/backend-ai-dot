# Copy this file to `.env` and fill in your own values.
# NEVER commit the `.env` file: it is listed in .gitignore.

# --- OpenAI (required) -------------------------------------------------------
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Any GPT-4 family chat model, e.g. gpt-4o-mini, gpt-4o, gpt-4.1-mini, gpt-4.1
OPENAI_MODEL=gpt-4o-mini
# Low temperature = consistent, technically precise answers
OPENAI_TEMPERATURE=0.3
# Upper bound for the length (and cost) of each answer, in tokens
OPENAI_MAX_TOKENS=4096
# Seconds to wait for OpenAI before giving up
OPENAI_TIMEOUT=60
# Automatic retries on transient errors (rate limit, connection)
OPENAI_MAX_RETRIES=2

# --- Conversation size ---------------------------------------------------------
# Total tokens the model accepts per request (prompt + answer). 128000 for
# gpt-4o / gpt-4o-mini; adjust it when changing the model.
OPENAI_CONTEXT_WINDOW=128000
# Token budget of a whole conversation (system prompt + full history + question).
# The history is never trimmed: past this budget the user must start a new
# conversation. 64000 (~120 questions) halves the cost of the last questions of a
# long conversation; MAX_CONVERSATION_TOKENS + OPENAI_MAX_TOKENS must fit in the window.
MAX_CONVERSATION_TOKENS=64000

# --- History router ------------------------------------------------------------
# Before each question, an LLM decides whether the conversation history is needed
# (follow-up) or not (self-contained question). Off by default: it adds ~1 s before
# every answer and only saves money in long conversations (see docs/EVALUATION.md).
HISTORY_ROUTER_ENABLED=false
# Cheapest/fastest OpenAI model for the yes/no decision (prefer a non-reasoning model)
HISTORY_ROUTER_MODEL=gpt-4o-mini

# --- Rate limit ------------------------------------------------------------------
# Questions one client IP may ask in the web UI and the API (0 disables a limit).
# Behind a reverse proxy the client IP is read from X-Forwarded-For. The CLI is
# never limited.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=100

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO

# --- Web interface (Chainlit) ------------------------------------------------
# Show the LangChain steps (prompt, model call...) inside the chat UI
CHAINLIT_SHOW_CHAIN_STEPS=false
# SQLite file that stores the conversation list of the web UI
CHAINLIT_DATABASE_PATH=data/chat_history.db
# Secret that signs the web session cookie. Optional: when empty, one is generated
# and saved in data/.chainlit_auth_secret. To set your own: uv run chainlit create-secret
CHAINLIT_AUTH_SECRET=

# --- LangSmith tracing (optional) --------------------------------------------
# Create a key at https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=python-chatbot
# Only change for self-hosted / EU instances
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
