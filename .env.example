# Copy to `.env` (next to docker-compose.yml) and fill in. Never commit `.env`.

# Base domain. Every project gets a subdomain: 01.DOMAIN, api-01.DOMAIN, 02.DOMAIN, 03.DOMAIN.
# Use `localhost` to run everything locally (https://01.localhost, ...).
DOMAIN=backend-ai-dot.oladata.com.br

# 01 - Optional shared secret between the library UI and its API.
API_KEY=

# 02 - Chatbot (required). Also used by 03 to rewrite queries (optional there).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional; generate with `uv run chainlit create-secret`.
CHAINLIT_AUTH_SECRET=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
